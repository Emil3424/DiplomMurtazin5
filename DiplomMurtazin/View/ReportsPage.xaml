<Page x:Class="DiplomMurtazin.View.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:core="clr-namespace:DiplomMurtazin.Core"
      Title="Отчеты"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      Background="#ecf0f1">

    <Page.Resources>
        <core:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Заголовок -->
            <TextBlock Text="Отчеты" 
                       FontSize="32" 
                       FontWeight="Bold"
                       Foreground="#2c3e50"
                       Margin="0,0,0,30"/>

            <!-- ОТЧЕТ ПО ПРОДАЖАМ -->
            <Border Background="White" 
                    Padding="20" 
                    CornerRadius="10" 
                    Margin="0,0,0,20"
                    BorderBrush="#bdc3c7"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Отчет по продажам" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Foreground="#2c3e50"
                               Margin="0,0,0,15"/>

                    <!-- Выбор периода -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="С:" 
                                   FontSize="14" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <DatePicker Grid.Column="1" 
                                    SelectedDate="{Binding StartDate}"
                                    Height="35"
                                    Margin="0,0,20,0"/>

                        <TextBlock Grid.Column="2" Text="По:" 
                                   FontSize="14" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <DatePicker Grid.Column="3" 
                                    SelectedDate="{Binding EndDate}"
                                    Height="35"
                                    Margin="0,0,20,0"/>

                        <Button Grid.Column="4" 
                                Content="Сформировать" 
                                Width="150" Height="35"
                                Command="{Binding GenerateSalesReportCommand}"
                                Background="#3498db" 
                                Foreground="White"
                                Cursor="Hand"
                                HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Сводка -->
                    <Border Background="#f8f9fa" 
                            Padding="15" 
                            CornerRadius="5" 
                            Margin="0,0,0,15"
                            Visibility="{Binding SalesSummary, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <StackPanel>
                            <TextBlock Text="Сводка по сотрудникам" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <DataGrid ItemsSource="{Binding SalesSummary}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      MaxHeight="200">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="200"/>
                                    <DataGridTextColumn Header="Продаж" Binding="{Binding SalesCount}" Width="80"/>
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:F2} ₽}" Width="120"/>
                                    <DataGridTextColumn Header="Ср. чек" Binding="{Binding AverageCheck, StringFormat={}{0:F2} ₽}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки экспорта -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content=" Сохранить в PDF" 
                                Width="150" Height="35" Margin="0,0,10,0"
                                Command="{Binding ExportSalesReportPdfCommand}"
                                Background="#27ae60" 
                                Foreground="White"
                                Cursor="Hand"/>
                        <Button Content=" Сохранить в CSV" 
                                Width="150" Height="35" Margin="0,0,10,0"
                                Command="{Binding ExportSalesReportCsvCommand}"
                                Background="#16a085" 
                                Foreground="White"
                                Cursor="Hand"/>
                        <Button Content=" Сохранить в Excel" 
                                Width="160" Height="35" Margin="0,0,10,0"
                                Command="{Binding ExportSalesReportExcelCommand}"
                                Background="#2c3e50" 
                                Foreground="White"
                                Cursor="Hand"/>

                        <TextBlock Text="{Binding SalesReport.Count, StringFormat=Найдено продаж: {0}}" 
                                   VerticalAlignment="Center"
                                   Foreground="#7f8c8d"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ОТЧЕТ ПО ОСТАТКАМ -->
            <Border Background="White" 
                    Padding="20" 
                    CornerRadius="10" 
                    Margin="0,0,0,20"
                    BorderBrush="#bdc3c7"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Отчет по остаткам товаров" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Foreground="#2c3e50"
                               Margin="0,0,0,15"/>

                    <Button Content="Сформировать отчет" 
                            Width="200" Height="35"
                            Command="{Binding GenerateStockReportCommand}"
                            Background="#3498db" 
                            Foreground="White"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,15"/>

                    <!-- Предпросмотр остатков -->
                    <Border Background="#f8f9fa" 
                            Padding="15" 
                            CornerRadius="5" 
                            Margin="0,0,0,15"
                            Visibility="{Binding StockReport, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Сводка:" FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding TotalProducts, StringFormat=Всего: {0}}" Margin="0,0,20,0"/>
                                <TextBlock Text="{Binding OutOfStockCount, StringFormat=Отсутствуют: {0}}" 
               Foreground="Red" Margin="0,0,20,0"/>
                                <TextBlock Text="{Binding BelowMinCount, StringFormat=Ниже минимума: {0}}" 
               Foreground="Orange"/>
                            </Grid>

                            <DataGrid ItemsSource="{Binding StockReport}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      MaxHeight="250">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="200"/>
                                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                                    <DataGridTextColumn Header="Остаток" Binding="{Binding CurrentStock}" Width="80"/>
                                    <DataGridTextColumn Header="Мин." Binding="{Binding MinStockLevel}" Width="60"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                                    <DataGridTextColumn Header="Стоимость" Binding="{Binding TotalValue, StringFormat={}{0:F2} ₽}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки экспорта -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content=" Сохранить в PDF" 
                                Width="150" Height="35" Margin="0,0,10,0"
                                Command="{Binding ExportStockReportPdfCommand}"
                                Background="#27ae60" 
                                Foreground="White"
                                Cursor="Hand"/>
                        <Button Content=" Сохранить в CSV" 
                                Width="150" Height="35" Margin="0,0,10,0"
                                Command="{Binding ExportStockReportCsvCommand}"
                                Background="#16a085" 
                                Foreground="White"
                                Cursor="Hand"/>
                        <Button Content=" Сохранить в Excel" 
                                Width="160" Height="35" Margin="0,0,10,0"
                                Command="{Binding ExportStockReportExcelCommand}"
                                Background="#2c3e50" 
                                Foreground="White"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- КАТАЛОГ ТОВАРОВ (EXCEL) -->
            <Border Background="White" 
                    Padding="20" 
                    CornerRadius="10"
                    BorderBrush="#bdc3c7"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Каталог товаров" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Foreground="#2c3e50"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Полный список всех товаров с ценами, характеристиками и остатками"
                               Foreground="#7f8c8d"
                               Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content=" Сохранить в PDF" 
                                Width="150" Height="35" Margin="0,0,10,0"
                                Command="{Binding ExportProductCatalogPdfCommand}"
                                Background="#27ae60" 
                                Foreground="White"
                                Cursor="Hand"/>
                        <Button Content=" Сохранить в CSV" 
                                Width="150" Height="35" Margin="0,0,10,0"
                                Command="{Binding ExportProductCatalogCsvCommand}"
                                Background="#16a085" 
                                Foreground="White"
                                Cursor="Hand"/>
                        <Button Content=" Сохранить в Excel" 
                                Width="160" Height="35"
                                Command="{Binding ExportProductCatalogExcelCommand}"
                                Background="#2c3e50" 
                                Foreground="White"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Отчет по возвратам -->
            <Border Background="White" Padding="20" CornerRadius="10" Margin="0,20,0,20" BorderBrush="#bdc3c7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Отчет по возвратам" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="С:" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding ReturnStartDate}"/>
                        <TextBlock Grid.Column="2" Text="По:" Margin="10,0,10,0" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="3" SelectedDate="{Binding ReturnEndDate}"/>
                        <TextBlock Grid.Column="4" Text="Статус:" Margin="10,0,10,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="5" ItemsSource="{Binding ReturnStatuses}" SelectedItem="{Binding ReturnStatusFilter}"/>
                        <TextBlock Grid.Column="6" Text="Гарантия:" Margin="10,0,10,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="7" ItemsSource="{Binding WarrantyOptions}" SelectedItem="{Binding SelectedWarrantyOption}"/>
                        <Button Grid.Column="8" Content="Сформировать" Command="{Binding GenerateReturnReportCommand}" Width="120" HorizontalAlignment="Left" Background="#3498db" Foreground="White"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding ReturnReport}" AutoGenerateColumns="False" MaxHeight="300" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ReturnID}" Width="60"/>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding ReturnDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding ReturnReason}" Width="180"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding RefundAmount, StringFormat={}{0:F2} ₽}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="PDF" Command="{Binding ExportReturnReportPdfCommand}" Margin="0,0,10,0" Width="80" Background="#2c3e50" Foreground="White"/>
                        <Button Content="CSV" Command="{Binding ExportReturnReportCsvCommand}" Margin="0,0,10,0" Width="80" Background="#27ae60" Foreground="White"/>
                        <Button Content="Excel" Command="{Binding ExportReturnReportExcelCommand}" Width="80" Background="#8e44ad" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Отчет по накладным ТОРГ-12 -->
            <Border Background="White" Padding="20" CornerRadius="10" Margin="0,20,0,20" BorderBrush="#bdc3c7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Отчет по накладным ТОРГ-12" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="С:" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding Torg12StartDate}"/>
                        <TextBlock Grid.Column="2" Text="По:" Margin="10,0,10,0" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="3" SelectedDate="{Binding Torg12EndDate}"/>
                        <TextBlock Grid.Column="4" Text="Статус:" Margin="10,0,10,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="5" ItemsSource="{Binding Torg12Statuses}" SelectedItem="{Binding Torg12StatusFilter}"/>
                        <TextBlock Grid.Column="6" Text="Получатель:" Margin="10,0,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="7" Text="{Binding Torg12ReceiverFilter, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                        <Button Grid.Column="8" Content="Сформировать" Command="{Binding GenerateTorg12ReportCommand}" Width="120" HorizontalAlignment="Left" Background="#3498db" Foreground="White"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Torg12Report}" AutoGenerateColumns="False" MaxHeight="300" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding DocumentNumber}" Width="120"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding DocumentDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Получатель" Binding="{Binding ReceiverName}" Width="*"/>
                            <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" Width="80"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:F2} ₽}" Width="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="PDF" Command="{Binding ExportTorg12ReportPdfCommand}" Margin="0,0,10,0" Width="80" Background="#2c3e50" Foreground="White"/>
                        <Button Content="CSV" Command="{Binding ExportTorg12ReportCsvCommand}" Margin="0,0,10,0" Width="80" Background="#27ae60" Foreground="White"/>
                        <Button Content="Excel" Command="{Binding ExportTorg12ReportExcelCommand}" Width="80" Background="#8e44ad" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- История индивидуального товара -->
            <Border Background="White" Padding="20" CornerRadius="10" Margin="0,20,0,20" BorderBrush="#bdc3c7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="История индивидуального товара" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Товар:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AllProducts}" SelectedItem="{Binding SelectedProductForHistory}" DisplayMemberPath="ProductName" Height="30"/>
                        <Button Grid.Column="2" Content="Показать историю" Command="{Binding GenerateProductHistoryCommand}" Width="140" HorizontalAlignment="Left" Margin="20,0,0,0" Background="#3498db" Foreground="White"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding ProductHistory}" AutoGenerateColumns="False" MaxHeight="300" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding EventDate, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Тип события" Binding="{Binding EventType}" Width="130"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:F2} ₽}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="PDF" Command="{Binding ExportProductHistoryPdfCommand}" Margin="0,0,10,0" Width="80" Background="#2c3e50" Foreground="White"/>
                        <Button Content="CSV" Command="{Binding ExportProductHistoryCsvCommand}" Margin="0,0,10,0" Width="80" Background="#27ae60" Foreground="White"/>
                        <Button Content="Excel" Command="{Binding ExportProductHistoryExcelCommand}" Width="80" Background="#8e44ad" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Каталог товаров с фильтром по товарам -->
            <Border Background="White" Padding="20" CornerRadius="10" Margin="0,20,0,20" BorderBrush="#bdc3c7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Каталог товаров (расширенный)" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <CheckBox Content="Включить фильтр по товарам" IsChecked="{Binding EnableProductFilter}" Margin="0,0,0,10"/>
                    <Grid IsEnabled="{Binding EnableProductFilter}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryForFilter}" DisplayMemberPath="CategoryName" Height="30" Margin="0,0,10,0"/>
                        <TextBlock Text="Товар:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding ProductNames}" SelectedItem="{Binding SelectedProductFilter}" IsEditable="True" Height="30"/>
                        <Button Grid.Column="4" Content="Добавить" Command="{Binding AddProductCommand}" Margin="10,0,5,0" Width="80" Background="#27ae60" Foreground="White"/>
                        <Button Grid.Column="4" Content="Очистить" Command="{Binding ClearSelectedProductsCommand}" Margin="95,0,0,0" Width="80" Background="#e74c3c" Foreground="White"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedProductsDisplay}" Margin="0,5,0,10" FontStyle="Italic" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="PDF" Command="{Binding ExportProductCatalogPdfCommand}" Margin="0,0,10,0" Width="80" Background="#2c3e50" Foreground="White"/>
                        <Button Content="CSV" Command="{Binding ExportProductCatalogCsvCommand}" Margin="0,0,10,0" Width="80" Background="#27ae60" Foreground="White"/>
                        <Button Content="Excel" Command="{Binding ExportProductCatalogExcelCommand}" Width="80" Background="#8e44ad" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Статус бар -->
            <Border Grid.Row="3" 
                    Background="{Binding StatusColor}"
                    Padding="10"
                    CornerRadius="5"
                    Margin="0,20,0,0">
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="White"
                           FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>