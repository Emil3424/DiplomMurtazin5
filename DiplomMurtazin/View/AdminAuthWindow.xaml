<Window x:Class="DiplomMurtazin.View.AdminAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение администратора" 
        Height="400" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Style="{StaticResource HeaderText}" 
                   Text="Вход администратора"
                   FontSize="22"/>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Логин:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" Style="{StaticResource RoundedTextBox}" Height="42"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock Text="Пароль:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}" Height="42"/>
        </StackPanel>

        <Border x:Name="ErrorBorder" Grid.Row="3" Margin="0,15,0,0"
                Background="#FFffee" BorderBrush="#e74c3c" BorderThickness="1" CornerRadius="5"
                Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="#e74c3c" Margin="10,10,30,10"
                           TextWrapping="Wrap" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                <Button Content="X" Width="20" Height="20" HorizontalAlignment="Right" 
                        VerticalAlignment="Top" Click="CloseErrorButton_Click"/>
            </Grid>
        </Border>

        <Button Grid.Row="4" Content="Войти" Style="{StaticResource PrimaryButton}" 
                Height="40" FontSize="16" Margin="0,25,0,0"
                Click="LoginButton_Click"/>
    </Grid>
</Window>