<Window x:Class="DiplomMurtazin.View.PriceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История изменения цены" Height="400" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <DataGrid ItemsSource="{Binding PriceHistory}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding ChangedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                <DataGridTextColumn Header="Старая цена" Binding="{Binding OldPrice, StringFormat={}{0:F2} ₽}" Width="120"/>
                <DataGridTextColumn Header="Новая цена" Binding="{Binding NewPrice, StringFormat={}{0:F2} ₽}" Width="120"/>
                <DataGridTextColumn Header="Изменил" Binding="{Binding ChangedByEmployeeName}" Width="150"/>
                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>