<Page x:Class="DiplomMurtazin.View.DefectiveProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:DiplomMurtazin.ViewModel"
      Background="#ecf0f1">

    <Page.DataContext>
        <vm:DefectiveProductsViewModel/>
    </Page.DataContext>

    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="10"
                Padding="20">

            <StackPanel>

                <TextBlock Text="Дефектные товары"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- ФИЛЬТРЫ -->

                <WrapPanel Margin="0,0,0,20">

                    <TextBox Width="220"
                             Height="35"
                             Margin="0,0,10,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText}"
                             />

                    <ComboBox Width="180"
                              Height="35"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding SelectedStatus}"/>

                    <DatePicker SelectedDate="{Binding StartDate}"
                                Margin="0,0,10,0"/>

                    <DatePicker SelectedDate="{Binding EndDate}"
                                Margin="0,0,10,0"/>

                    <Button Content="Применить"
                            Width="120"
                            Height="35"
                            Command="{Binding RefreshCommand}"
                            Background="#3498db"
                            Foreground="White"/>

                </WrapPanel>

                <!-- ТАБЛИЦА -->

                <DataGrid ItemsSource="{Binding DefectiveItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Height="600">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding DefectiveID}"
                                            Width="70"/>

                        <DataGridTextColumn Header="Товар"
                                            Binding="{Binding ProductName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Причина"
                                            Binding="{Binding Reason}"
                                            Width="200"/>

                        <DataGridTextColumn Header="Количество"
                                            Binding="{Binding Quantity}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding ReturnDate}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Status}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Комментарий"
                                            Binding="{Binding Notes}"
                                            Width="250"/>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Border>

    </Grid>

</Page>