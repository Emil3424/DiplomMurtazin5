<Page x:Class="DiplomMurtazin.View.DefectiveProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#ecf0f1">

    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="10"
                Padding="15">

            <StackPanel>

                <TextBlock Text="Дефектные товары"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <DataGrid ItemsSource="{Binding DefectiveProducts}"
                          AutoGenerateColumns="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="UnitID"
                                            Binding="{Binding UnitID}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Товар"
                                            Binding="{Binding ProductName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Причина"
                                            Binding="{Binding Reason}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Status}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding CreatedDate,
                                                      StringFormat=dd.MM.yyyy HH:mm}"
                                            Width="160"/>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Border>

    </Grid>

</Page>